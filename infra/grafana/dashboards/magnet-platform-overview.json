{
  "annotations": {
    "list": []
  },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Platform Health & Key Indicators",
      "type": "row"
    },
    {
      "id": 1,
      "title": "Platform Health",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "up{job=\"magnet-platform\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red" },
                "1": { "text": "HEALTHY", "color": "green" }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "red" },
              { "value": 1, "color": "green" }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "title": "Active Tasks",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(magnet_tasks{status=~\"DOWNLOADING|VERIFYING\"}) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "blue" }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 3,
      "title": "Active Engine Sessions",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(magnet_engine_sessions{state=\"ACTIVE\"}) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 4,
      "title": "Recent Errors (5m)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "(sum(increase(magnet_engine_errors_total[5m])) or vector(0)) + (sum(increase(magnet_lease_failures_total[5m])) or vector(0))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 1, "color": "red" }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "Throughput & Scheduling",
      "type": "row"
    },
    {
      "id": 5,
      "title": "Task Status Distribution & Queue Depth",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum by (status) (magnet_tasks)",
          "legendFormat": "Tasks: {{status}}",
          "refId": "A"
        },
        {
          "expr": "magnet_task_queue_depth",
          "legendFormat": "Queue Depth",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 10
          }
        }
      }
    },
    {
      "id": 6,
      "title": "Engine Download / Upload Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "magnet_engine_download_rate_bytes_per_second",
          "legendFormat": "DL: {{engine}}",
          "refId": "A"
        },
        {
          "expr": "magnet_engine_upload_rate_bytes_per_second",
          "legendFormat": "UL: {{engine}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "binBps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15
          }
        }
      }
    },
    {
      "id": 7,
      "title": "Scheduler Tick Latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(magnet_scheduler_tick_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(magnet_scheduler_tick_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(magnet_scheduler_tick_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line"
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 102,
      "title": "Workers, Leases & Errors",
      "type": "row"
    },
    {
      "id": 8,
      "title": "Active Workers & Leases",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "magnet_active_workers",
          "legendFormat": "Active Workers",
          "refId": "A"
        },
        {
          "expr": "magnet_leases_active",
          "legendFormat": "Active Leases",
          "refId": "B"
        },
        {
          "expr": "rate(magnet_lease_failures_total[5m]) or vector(0)",
          "legendFormat": "Lease Failures Rate",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "custom": {
            "drawStyle": "line"
          }
        }
      }
    },
    {
      "id": 9,
      "title": "Engine Errors by Type",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "(sum by (engine, error_type) (rate(magnet_engine_errors_total[5m]))) or vector(0)",
          "legendFormat": "{{engine}} - {{error_type}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "0",
          "custom": {
            "drawStyle": "bars"
          }
        }
      }
    },
    {
      "id": 10,
      "title": "SSE Connections & Disconnect Reasons",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "magnet_sse_connections",
          "legendFormat": "Active SSE Connections",
          "refId": "A"
        },
        {
          "expr": "sum by (reason) (rate(magnet_sse_disconnects_total[5m]))",
          "legendFormat": "Disconnect: {{reason}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "custom": {
            "drawStyle": "line"
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "id": 103,
      "title": "Domain Pipelines: Parse, Export & GC",
      "type": "row"
    },
    {
      "id": 11,
      "title": "Parse Operations Rate & Duration",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum by (result) (rate(magnet_parse_jobs_total[5m]))",
          "legendFormat": "Parse Rate ({{result}})",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(magnet_parse_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "Parse p95 Duration",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "custom": {
            "drawStyle": "line"
          }
        }
      }
    },
    {
      "id": 12,
      "title": "Export Operations Rate & Duration",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum by (result) (rate(magnet_exports_total[5m]))",
          "legendFormat": "Export Rate ({{result}})",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(magnet_export_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "Export p95 Duration",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "custom": {
            "drawStyle": "line"
          }
        }
      }
    },
    {
      "id": 13,
      "title": "GC Runs Rate & Duration",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum by (result) (rate(magnet_gc_runs_total[5m]))",
          "legendFormat": "GC Rate ({{result}})",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(magnet_gc_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "GC p95 Duration",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "custom": {
            "drawStyle": "line"
          }
        }
      }
    }
  ],
