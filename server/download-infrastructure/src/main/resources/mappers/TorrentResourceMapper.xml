<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cc.ivera.magnet.infrastructure.mapper.TorrentResourceMapper">

    <resultMap id="resource" type="cc.ivera.magnet.domain.resource.TorrentResource">
        <constructor>
            <arg column="id" javaType="java.util.UUID"/>
            <arg column="canonical_key" javaType="java.lang.String"/>
            <arg column="btih" javaType="byte[]"/>
            <arg column="btmh" javaType="byte[]"/>
            <arg column="version_type" javaType="cc.ivera.magnet.domain.resource.VersionType"/>
            <arg column="name" javaType="java.lang.String"/>
            <arg column="piece_length" javaType="java.lang.Long"/>
            <arg column="total_bytes" javaType="java.lang.Long"/>
            <arg column="private_flag" javaType="boolean"/>
            <arg column="metadata_source" javaType="java.lang.String"/>
            <arg column="trackers" javaType="java.util.List"
                 typeHandler="cc.ivera.magnet.infrastructure.mybatis.JsonListTypeHandler"/>
            <arg column="file_count" javaType="java.lang.Integer"/>
            <arg column="created_at" javaType="java.time.LocalDateTime"/>
            <arg column="metadata_path" javaType="java.lang.String"/>
        </constructor>
    </resultMap>

    <resultMap id="file" type="cc.ivera.magnet.domain.resource.TorrentFileInfo">
        <constructor>
            <arg column="file_index" javaType="int"/>
            <arg column="relative_path" javaType="java.lang.String"/>
            <arg column="size_bytes" javaType="long"/>
            <arg column="v2_pieces_root" javaType="java.lang.String"/>
        </constructor>
    </resultMap>

    <sql id="columns">id, canonical_key, btih, btmh, version_type, name, piece_length, total_bytes,
        private_flag, metadata_source, trackers, file_count, created_at, metadata_path</sql>

    <select id="findById" resultMap="resource">
        SELECT <include refid="columns"/> FROM torrent_resource WHERE id = #{id}
    </select>

    <select id="findByHash" resultMap="resource">
        SELECT <include refid="columns"/> FROM torrent_resource r
        JOIN resource_hash_alias a ON a.resource_id = r.id
        WHERE a.hash_type = #{hashType} AND a.hash_bytes = #{hashBytes}
        LIMIT 1
    </select>

    <insert id="insert" parameterType="cc.ivera.magnet.domain.resource.TorrentResource">
        INSERT INTO torrent_resource (<include refid="columns"/>)
        VALUES (#{id}, #{canonicalKey}, #{btih}, #{btmh}, #{versionType}, #{name}, #{pieceLength},
                #{totalBytes}, #{privateFlag}, #{metadataSource},
                #{trackers, typeHandler=cc.ivera.magnet.infrastructure.mybatis.JsonListTypeHandler},
                #{fileCount}, #{createdAt}, #{metadataPath})
    </insert>

    <insert id="insertAlias">
        INSERT INTO resource_hash_alias (hash_type, hash_bytes, resource_id)
        VALUES (#{hashType}, #{hashBytes}, #{resourceId})
    </insert>

    <update id="update" parameterType="cc.ivera.magnet.domain.resource.TorrentResource">
        UPDATE torrent_resource
        SET btih = #{btih}, btmh = #{btmh}, version_type = #{versionType}, name = #{name},
            piece_length = #{pieceLength}, total_bytes = #{totalBytes}, private_flag = #{privateFlag},
            trackers = #{trackers, typeHandler=cc.ivera.magnet.infrastructure.mybatis.JsonListTypeHandler},
            file_count = #{fileCount}, metadata_path = #{metadataPath}
        WHERE id = #{id}
    </update>

    <insert id="insertFile">
        INSERT INTO torrent_file (id, resource_id, file_index, relative_path, size_bytes, v2_pieces_root)
        VALUES (#{id}, #{resourceId}, #{file.fileIndex}, #{file.relativePath}, #{file.sizeBytes},
                #{file.v2PiecesRootHex})
    </insert>

    <select id="findFiles" resultMap="file">
        SELECT file_index, relative_path, size_bytes, v2_pieces_root
        FROM torrent_file WHERE resource_id = #{resourceId} ORDER BY file_index
    </select>
</mapper>
