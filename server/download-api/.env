# Magnet Platform 本地开发配置（由 application.yml 的 spring.config.import 读取）
# 注意：这是 properties 格式，KEY=VALUE，不要加引号；系统环境变量优先级高于本文件

# ---- 下载引擎：true=C++ gRPC Sidecar，false=Mock ----
MAGNET_GRPC_ENABLED=true
MAGNET_GRPC_ENDPOINT=localhost:50051
MAGNET_GRPC_INSECURE=true

# ---- 数据库 / Redis ----
DB_URL=jdbc:mysql://localhost:3306/magnet?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
DB_USER=root
DB_PASSWORD=magnet
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- 安全（本地开发专用，生产必须覆盖）----
JWT_SECRET=Una5yzsLMNVBYERhWBTSdOuDvuMOduOpOiIaoCmMdVTIpD84i2qVnc78O3Codspo

# ---- 存储 ----
STORAGE_ROOT=D:/release/magnet/server/download-api/data

# ---- 解析：DHT 冷启动元数据抓取较慢，本地放宽到 300s ----
PARSE_TIMEOUT_SECONDS=300

# ---- HTTP 探测代理（可选，host:port；直连被污染/不通的境外资源时启用）----
MAGNET_HTTP_PROXY=127.0.0.1:10808

# ---- GC：无引用资源宽限期（秒）与清扫间隔（毫秒）----
GC_GRACE_SECONDS=300
GC_SWEEP_DELAY_MS=60000
MAGNET_ARIA2_RPC_SECRET=155bba96a8223156e12979c304022ce8c0d6a3f48d3af605721fa1a949b705d7
MAGNET_ARIA2_RPC_ENABLED=true
MAGNET_ARIA2_RPC_ENDPOINT=http://localhost:6800/jsonrpc
MAGNET_ARIA2_STORAGE_ROOT=/data

MAGNET_METRICS_SCRAPE_PASSWORD_FILE=D:/release/magnet/infra/.secrets/prometheus-scrape-password
